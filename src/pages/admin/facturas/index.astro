---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { supabaseAdmin } from "@/lib/supabase";
import InvoicesList from "@/components/islands/admin/InvoicesList";

// Parse URL params
const page = parseInt(Astro.url.searchParams.get("page") || "1");
const searchQuery = Astro.url.searchParams.get("q") || "";
const dateFrom = Astro.url.searchParams.get("from") || "";
const dateTo = Astro.url.searchParams.get("to") || "";
const activeTab = Astro.url.searchParams.get("tab") || "facturas";
const limit = 20;
const offset = (page - 1) * limit;

// === Query de facturas (solo si tab=facturas) ===
let invoices: any[] = [];
let invoiceCount = 0;
let invoiceError: any = null;

if (activeTab === "facturas") {
  let query = supabaseAdmin
    .from("fiscal_documents")
    .select(
      "id, document_number, order_id, customer_nif, customer_name, customer_fiscal_address, total, issued_at, pdf_url, document_type, orders!inner(order_number, customer_name)",
      { count: "exact" }
    )
    .in("document_type", ["invoice", "rectifying"])
    .order("issued_at", { ascending: false });

  if (searchQuery) {
    query = query.or(
      `document_number.ilike.%${searchQuery}%,customer_name.ilike.%${searchQuery}%,customer_nif.ilike.%${searchQuery}%`
    );
  }
  if (dateFrom) {
    query = query.gte("issued_at", `${dateFrom}T00:00:00`);
  }
  if (dateTo) {
    query = query.lte("issued_at", `${dateTo}T23:59:59`);
  }

  const { data: rawInvoices, count, error } = await query.range(offset, offset + limit - 1);
  invoiceError = error;
  invoiceCount = count || 0;

  invoices = (rawInvoices || []).map((inv: any) => ({
    id: inv.id,
    invoice_number: inv.document_number,
    order_id: inv.order_id,
    order_number: inv.orders?.order_number || null,
    customer_name: inv.orders?.customer_name || inv.customer_name || null,
    customer_nif: inv.customer_nif,
    customer_fiscal_name: inv.customer_name,
    customer_fiscal_address: inv.customer_fiscal_address,
    total: inv.total,
    issued_at: inv.issued_at,
    pdf_url: inv.pdf_url,
  }));
}

// === Query de tickets (documentos simplificados, solo si tab=tickets) ===
let ticketOrders: any[] = [];
let ticketCount = 0;
let ticketError: any = null;

if (activeTab === "tickets") {
  let ticketQuery = supabaseAdmin
    .from("fiscal_documents")
    .select(
      "id, order_id, document_number, customer_name, customer_email, total, issued_at, pdf_url, pdf_storage_path, metadata, orders!inner(order_number, status, created_at)",
      { count: "exact" }
    )
    .eq("document_type", "simplified")
    .order("issued_at", { ascending: false });

  if (searchQuery) {
    const num = parseInt(searchQuery.replace(/[^0-9]/g, ''), 10);
    if (!isNaN(num) && num > 0) {
      ticketQuery = ticketQuery.contains("metadata", { order_number: num });
    } else {
      ticketQuery = ticketQuery.or(
        `document_number.ilike.%${searchQuery}%,customer_name.ilike.%${searchQuery}%,customer_email.ilike.%${searchQuery}%`
      );
    }
  }
  if (dateFrom) {
    ticketQuery = ticketQuery.gte("issued_at", `${dateFrom}T00:00:00`);
  }
  if (dateTo) {
    ticketQuery = ticketQuery.lte("issued_at", `${dateTo}T23:59:59`);
  }

  const { data, count, error } = await ticketQuery.range(offset, offset + limit - 1);
  ticketOrders = (data || []).map((ticket: any) => {
    const order = Array.isArray(ticket.orders) ? ticket.orders[0] : ticket.orders;
    return {
      id: ticket.order_id,
      order_number: order?.order_number ?? ticket.metadata?.order_number ?? null,
      customer_name: ticket.customer_name,
      customer_email: ticket.customer_email,
      total_amount: ticket.total,
      status: order?.status || "paid",
      created_at: order?.created_at || ticket.issued_at,
      ticket_number: ticket.document_number,
      ticket_pdf_url: ticket.pdf_url,
      ticket_pdf_storage_path: ticket.pdf_storage_path,
      ticket_issued_at: ticket.issued_at,
    };
  });
  ticketCount = count || 0;
  ticketError = error;
}

const error = invoiceError || ticketError;
---

<AdminLayout title="Facturas">
  {error ? (
    <div class="p-4 bg-red-500/10 border border-red-500/30 rounded-lg text-red-600 dark:text-red-400">
      Error cargando datos: {error.message}
    </div>
  ) : (
    <InvoicesList
      client:load
      initialInvoices={invoices}
      totalCount={invoiceCount}
      initialTicketOrders={ticketOrders}
      ticketTotalCount={ticketCount}
      activeTab={activeTab}
      currentPage={page}
      pageSize={limit}
      initialSearch={searchQuery}
      initialFrom={dateFrom}
      initialTo={dateTo}
    />
  )}
</AdminLayout>
